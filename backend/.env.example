# Environment variables template for Military Asset Management System Backend

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-32-character-random-secure-secret-key

# PostgreSQL Connection String
# Format: postgresql://username:password@hostname:port/database_name?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/military_assets?schema=public"
